# Bu dosyayı .env.local adıyla kopyalayıp değeri doldurun. .env.local commit'lenmez.
# Webhook adresi yalnızca sunucuda (api/ route'ları) okunur, tarayıcı koduna girmez.
# Yerelde webhook.site test adresi kullanın; yayındaki adres Vercel panelinden girilir.
WEBHOOK_URL=

# İsteğe bağlı: istek sınırı için Upstash Redis. Boş bırakılırsa yerelde bellekteki
# sayaç kullanılır. Yayında Vercel'in Upstash entegrasyonu bunları kendisi ekler.
KV_REST_API_URL=
KV_REST_API_TOKEN=
